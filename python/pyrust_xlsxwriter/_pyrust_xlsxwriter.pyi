        self,
        name: str = "",
        active: bool = False,
        selected: bool = False,
        hidden: bool = False,
        tab_color: ColorInput | None = None,
        default_row_height: float | None = None,
        paper_size: PaperSizeInput | None = None,
        header: str = "",
        footer: str = "",
        print_center_horizontally: bool = False,
        print_center_vertically: bool = False,
        screen_gridlines: bool = True,
        print_gridlines: bool = False,
        print_headings: bool = False,
        zoom: int = 100,
        right_to_left: bool = False,
    ) -> None: ...
