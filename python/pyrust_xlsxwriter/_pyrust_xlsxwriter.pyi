@final
class IgnoreError:
    """Excel warning (green triangle) types that `Worksheet.ignore_error()` turns off."""

    NumberStoredAsText: ClassVar[IgnoreError]
    FormulaError: ClassVar[IgnoreError]
    FormulaDiffers: ClassVar[IgnoreError]
    FormulaRefersToEmptyCells: ClassVar[IgnoreError]
    FormulaOmitsCells: ClassVar[IgnoreError]
    DataValidationError: ClassVar[IgnoreError]
    TwoDigitTextYear: ClassVar[IgnoreError]
    UnlockedCellsWithFormula: ClassVar[IgnoreError]
    InconsistentColumnFormula: ClassVar[IgnoreError]
    def __int__(self) -> int: ...

