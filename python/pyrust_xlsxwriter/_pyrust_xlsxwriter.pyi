"""Type stubs for the compiled extension module.

Hand-written. Each feature area has its own marked section; keep additions
inside the matching section. Rows and columns are zero-based, and every
method taking a cell or range also accepts "A1" / "A1:B2" strings.
"""

import datetime
import decimal
import os
from collections.abc import Buffer, Iterable, Iterator, Sequence
from typing import IO, Any, BinaryIO, ClassVar, Literal, Self, final, overload

type ColorLike = Color | str | int | tuple[int, int, int]
type PathLike = str | os.PathLike[str]
type CellValue = (
    str
    | int
    | float
    | bool
    | decimal.Decimal
    | datetime.datetime
    | datetime.date
    | datetime.time
    | datetime.timedelta
    | Formula
    | Url
    | None
)
type RichSegment = str | tuple[Format, str]

__version__: str

# =============================================================================
# [common] errors
# =============================================================================

class XlsxError(Exception):
    """Base class for all pyrust_xlsxwriter errors."""

class ParameterError(XlsxError, ValueError):
    """An argument value is invalid for Excel."""

class SheetNameError(ParameterError):
    """Invalid, duplicate or unknown worksheet name."""

class OverlapError(ParameterError):
    """A merged range, table or autofilter overlaps an existing one."""

class ImageError(ParameterError):
    """The image type or dimensions are not supported."""

class RangeError(XlsxError, IndexError):
    """A row/column is outside Excel's limits or a range is reversed."""

class FileError(XlsxError, OSError):
    """Reading or writing a file failed."""

class ReadError(XlsxError):
    """A spreadsheet could not be read."""

class EditError(XlsxError):
    """A change could not be applied to an existing workbook."""

