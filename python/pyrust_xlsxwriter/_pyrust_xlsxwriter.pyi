    @tab_color.setter
    def tab_color(self, value: ColorInput | None) -> None: ...
    @property
    def default_row_height(self) -> float | None: ...
    @default_row_height.setter
    def default_row_height(self, value: float | None) -> None: ...
    @property
    def paper_size(self) -> PaperSizeInput | None: ...
    @paper_size.setter
    def paper_size(self, value: PaperSizeInput | None) -> None: ...
    @property
    def header(self) -> str: ...
    @header.setter
    def header(self, value: str) -> None: ...
    @property
    def footer(self) -> str: ...
    @footer.setter
    def footer(self, value: str) -> None: ...
    @property
    def print_center_horizontally(self) -> bool: ...
    @print_center_horizontally.setter
    def print_center_horizontally(self, value: bool) -> None: ...
    @property
    def print_center_vertically(self) -> bool: ...
    @print_center_vertically.setter
    def print_center_vertically(self, value: bool) -> None: ...
    @property
    def screen_gridlines(self) -> bool: ...
    @screen_gridlines.setter
    def screen_gridlines(self, value: bool) -> None: ...
    @property
    def print_gridlines(self) -> bool: ...
    @print_gridlines.setter
    def print_gridlines(self, value: bool) -> None: ...
    @property
    def print_headings(self) -> bool: ...
    @print_headings.setter
    def print_headings(self, value: bool) -> None: ...
    @property
    def zoom(self) -> int: ...
    @zoom.setter
    def zoom(self, value: int) -> None: ...
    @property
    def right_to_left(self) -> bool: ...
    @right_to_left.setter
    def right_to_left(self, value: bool) -> None: ...
    def write(self, row: int, col: int, value: Any, format: Format | None = None) -> None: ...
    def write_row(self, row: int, col: int, data: Sequence[Any], format: Format | None = None) -> None: ...
    def write_column(self, row: int, col: int, data: Sequence[Any], format: Format | None = None) -> None: ...
    def write_number(self, row: int, col: int, number: float, format: Format | None = None) -> None: ...
    def write_string(self, row: int, col: int, string: str, format: Format | None = None) -> None: ...
    def write_boolean(self, row: int, col: int, value: bool, format: Format | None = None) -> None: ...
    def write_formula(self, row: int, col: int, formula: str, format: Format | None = None) -> None: ...
    def merge_range(
        self,
        first_row: int,
        first_col: int,
        last_row: int,
        last_col: int,
        string: str,
        format: Format | None = None,
    ) -> None: ...
    def set_column_width(self, col: int, width: float, format: Format | None = None) -> None: ...
    def set_column_range_width(
        self, first_col: int, last_col: int, width: float, format: Format | None = None
    ) -> None: ...
    def set_row_height(self, row: int, height: float, format: Format | None = None) -> None: ...
    def set_landscape(self) -> None: ...
    def set_portrait(self) -> None: ...
    def set_fit_to_pages(self, width: int, height: int) -> None: ...
    def autofit(self) -> None: ...
    def freeze_panes(self, row: int, col: int) -> None: ...
    def set_vba_name(self, name: str) -> None: ...
    def insert_chart(self, row: int, col: int, chart: Chart) -> None: ...
    def insert_chart_with_offset(self, row: int, col: int, chart: Chart, x_offset: int, y_offset: int) -> None: ...
    def add_sparkline(self, row: int, col: int, sparkline: Sparkline) -> None: ...
    def add_conditional_format_2color_scale(
        self,
        first_row: int,
        first_col: int,
        last_row: int,
        last_col: int,
        cond_fmt: ConditionalFormat2ColorScale,
    ) -> None: ...
    def add_conditional_format_3color_scale(
        self,
        first_row: int,
        first_col: int,
        last_row: int,
        last_col: int,
        cond_fmt: ConditionalFormat3ColorScale,
    ) -> None: ...
    def add_conditional_format_data_bar(
        self,
        first_row: int,
        first_col: int,
        last_row: int,
        last_col: int,
        cond_fmt: ConditionalFormatDataBar,
    ) -> None: ...

